{
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_AARCH64"],
  "syscalls": [
    {
      "names": [
        "accept4", "bind", "brk", "clock_gettime", "close", "connect",
        "epoll_create1", "epoll_ctl", "epoll_wait", "epoll_pwait",
        "exit", "exit_group",
        "fstat", "fstatfs",
        "futex",
        "getpid", "getsockname", "getsockopt", "gettid", "getrandom",
        "ioctl",
        "listen",
        "madvise", "mmap", "mprotect", "munmap",
        "nanosleep",
        "open", "openat",
        "pipe2", "pread64", "pwrite64",
        "read", "readv",
        "recvfrom", "recvmsg",
        "rt_sigaction", "rt_sigprocmask", "rt_sigreturn",
        "sched_getaffinity", "sched_yield",
        "sendmsg", "sendto", "set_robust_list",
        "setsockopt", "sigaltstack",
        "socket",
        "tgkill",
        "uname",
        "write", "writev"
      ],
      "action": "SCMP_ACT_ALLOW"
    }
  ]
