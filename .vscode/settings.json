    "spellright.language": [
        "en"
    ],
    "spellright.documentTypes": [
        "latex"
    ],
    "files.watcherExclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/build/**": true,
        "**/.dart_tool/**": true,
        "**/Android/Sdk/**": true,
        "**/.gradle/**": true,
        "**/ios/**": true,
        "**/android/build/**": true
    },
    
    // Dart extension will auto-detect Flutter SDK from PATH if not specified.
    // If you need to specify a path, add to your USER settings:
    //   "dart.flutterSdkPath": "/path/to/flutter"
    // or
    //   "dart.flutterSdkPath": "C:\\path\\to\\flutter"
    
    "dart.flutterSdkPaths": [
        // Windows paths
        "C:\\code\\libs\\flutter",
        // Linux paths
        "/home/serhatakbak/code/lib/flutter",
        "/home/tech/snap/flutter/common/flutter",
        // macOS paths
        "/Users/${env:USER}/development/flutter"
    ]
