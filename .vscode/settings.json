{
    "files.watcherExclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/build/**": true,
        "**/.dart_tool/**": true,
        "**/Android/Sdk/**": true,
        "**/.gradle/**": true,
        "**/ios/**": true,
        "**/android/build/**": true
    },
    "search.exclude": {
        "**/build/**": true,
        "**/.dart_tool/**": true,
        "**/.cxx/**": true
    },
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.tabs.enabled": true,

    // Enable repo-local prompt files (.github/prompts/*.prompt.md) and custom
    // chat modes (.github/chatmodes/*.chatmode.md) as slash commands in Copilot Chat.
    "chat.promptFiles": true,
    "chat.promptFilesLocations": {
        ".github/prompts": true
    },
    "chat.modeFilesLocations": {
        ".github/chatmodes": true
    },
    "chat.instructionsFilesLocations": {
        ".github": true
    },
    
    // Dart extension will auto-detect Flutter SDK from PATH if not specified.
    // If you need to specify a path, add to your USER settings:
    //   "dart.flutterSdkPath": "/path/to/flutter"
    // or
    //   "dart.flutterSdkPath": "C:\\path\\to\\flutter"
    
    "dart.flutterSdkPaths": [
        // Windows paths
        "C:\\code\\libs\\flutter",
        // Linux paths
        "/home/serhatakbak/code/lib/flutter",
        "/home/tech/snap/flutter/common/flutter"
    ]
}