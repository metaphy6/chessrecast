# Mercenary AI Training Configuration
# Copy this file to .env and adjust values as needed

# TEST_MODE: true for random games (testing), false for neural network training
TEST_MODE=false

# MOVE_DELAY: Delay between moves in seconds (0.1 to 10)
# - 0.1-0.5: Fast (hard to follow visually)
# - 1.0-2.0: Good for watching (default: 1.0)
# - 3.0-5.0: Slow demo mode
# - Training mode: ignored (games play at max speed)
MOVE_DELAY=1.0

# Examples:
# Fast test mode:     TEST_MODE=true  MOVE_DELAY=0.3
# Watchable games:    TEST_MODE=true  MOVE_DELAY=1.5
# Slow demo:          TEST_MODE=true  MOVE_DELAY=5.0
# Full training:      TEST_MODE=false MOVE_DELAY=0.3
