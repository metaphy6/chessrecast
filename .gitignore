# Ignore build outputs for the frontend (e.g. Flutter web/build or mobile release assets)
# Use a rooted pattern so it applies to the repo-relative `frontend/build` directory.
/frontend/build/

# Local native-engine build artifacts should never be committed.
/frontend/libchess_engine.so

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug

# CodeGraph local knowledge-graph database + watcher state (regenerated on demand).
# Pin and configs are checked in; the index itself is not.
.codegraph/
/android/app/profile
/android/app/release
