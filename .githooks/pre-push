#!/usr/bin/env bash
# .githooks/pre-push
#
# Repo-local pre-push hook. Activated by:
#   git config core.hooksPath .githooks
#
# Per AGENTS.md §4, the agent must NOT change global git config. The user opts
# in once per workstation by running the line above (or the helper in
# scripts/agent/install-hooks.sh).
#
# What it does:
#   1. Refuses to push if the working tree is dirty (catches "I forgot to commit
#      the test").
#   2. Looks at the diff between the local branch and origin/main and runs the
#      regression test for every mod whose source / test tree was touched.
#   3. Always runs king_castling_policy_regression_test.dart (cheap, catches
#      cross-mod policy drift).
#   4. Runs the test-diff lint to catch silenced/weakened tests.
#
# To bypass for a true emergency, the user (NOT the agent) can `git push --no-verify`.
# Per the Copilot instructions, the agent is forbidden from using --no-verify.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# 1. Reject if dirty.
if [[ -n "$(git status --porcelain)" ]]; then
  echo "pre-push: refusing — working tree is dirty. Commit or stash first."
  exit 1
fi

# 2. Determine which mods were touched.
range="origin/main...HEAD"
if ! git rev-parse --verify --quiet origin/main >/dev/null; then
  range="HEAD~1...HEAD"
fi
changed=$(git diff --name-only "$range" 2>/dev/null || true)
if [[ -z "$changed" ]]; then
  echo "pre-push: no diff vs $range — nothing to validate."
  exit 0
fi

mods_touched=()
for mod in heir friendly_fire kings_battle mercenary save_the_queen succession truce; do
  if echo "$changed" | grep -E -q "(frontend/lib/(mods|engine)/${mod}|frontend/native/engine/(eval|search)/[^/]*${mod}|frontend/test/(manual_)?${mod}_)"; then
    mods_touched+=("$mod")
  fi
done

# 3. Check for risky test edits.
if [[ -x "$repo_root/frontend/tool/check_test_diff.dart" ]] || [[ -f "$repo_root/frontend/tool/check_test_diff.dart" ]]; then
  echo "pre-push: scanning test diff for skip / weakened-assertion patterns..."
  ( cd "$repo_root/frontend" && dart run tool/check_test_diff.dart "$range" ) || {
    echo "pre-push: test-diff lint failed."
    exit 1
  }
fi

# 4. Build native lib if absent (cheap if already built).
if [[ ! -f "$repo_root/frontend/build/native/linux/libchess_engine.so" ]]; then
  echo "pre-push: native lib missing; building..."
  ( cd "$repo_root/frontend" && cmake --build build/native/linux ) || {
    echo "pre-push: native build failed."
    exit 1
  }
fi

# 5. Always run king-castling regression.
test_files=("test/king_castling_policy_regression_test.dart")

# 6. Add per-mod regression tests.
for mod in "${mods_touched[@]}"; do
  t="test/${mod}_engine_regression_test.dart"
  if [[ -f "$repo_root/frontend/$t" ]]; then
    test_files+=("$t")
  fi
done

if (( ${#mods_touched[@]} > 0 )); then
  echo "pre-push: mods touched: ${mods_touched[*]}"
fi
echo "pre-push: running ${#test_files[@]} test file(s)..."

(
  cd "$repo_root/frontend"
  CHESSRECAST_NATIVE_ENGINE_LIB="$PWD/build/native/linux/libchess_engine.so" \
  LD_LIBRARY_PATH="$PWD/build/native/linux:$PWD" \
  flutter test "${test_files[@]}" -r compact
) || {
  echo "pre-push: regression tests failed. Push aborted."
  exit 1
}

echo "pre-push: ok."
